# Required to protect private endpoints
RENDER_SHARED_SECRET=replace_with_a_long_random_secret
# Public URL of this Render service, e.g. https://echomate-ai.onrender.com
RENDER_SERVER_URL=
# Base URL of the Lovable app that accepts callbacks, without trailing slash
BOT_CALLBACK_BASE_URL=

# Required only for Telegram group-call playback (never publish these values)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
